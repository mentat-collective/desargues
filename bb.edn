{:paths ["src"]
 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :refer [shell]])

  doctor        {:doc "Check the JVM, the Manim env, LaTeX and ffmpeg"
                 :task (shell "clojure -M:doctor")}
  test          {:doc "Every suite (the Manim suites need the conda env)"
                 :task (shell "clojure -M:test")}
  test:dynamics {:doc "Every suite plus the raster solver conformance"
                 :task (shell "clojure -M:test:dynamics")}
  typecheck     {:doc "Static Typed Clojure gate"
                 :task (shell "clojure -M:dev -m desargues.typecheck")}
  bench         {:doc "Every bench suite (core, hotpaths, geometry) -> bench/results/latest.edn + doc/bench/*.svg. Args: --only core,hotpaths,geometry --manim --charts-only"
                 :task (apply shell "clojure -M:bench:dynamics" *command-line-args*)}
  bench:check   {:doc "Fresh run vs bench/results/baseline.edn; exits 1 on a regression (median beyond --tolerance, default 0.25, and 3x MAD)"
                 :task (apply shell "clojure -M:bench:dynamics --check" *command-line-args*)}
  bench:baseline {:doc "Fresh run, saved as bench/results/baseline.edn (commit it)"
                  :task (apply shell "clojure -M:bench:dynamics --save-baseline" *command-line-args*)}
  site          {:doc "Landing page -> dist/site (plato deck under site/, live scenes, bench charts)"
                 :task (do (fs/create-dirs "dist/site/assets")
                           (shell "clojure -M:site build --deck desargues.site.deck/model"
                                  "-o" "dist/site/index.html"
                                  "--assets" "site/public" "--live-scenes" "--math")
                           (fs/copy-tree "site/public/fonts" "dist/site/fonts" {:replace-existing true})
                           (fs/copy-tree "doc/bench" "dist/site/assets/bench" {:replace-existing true}))}
  showcase      {:doc "README gallery -> doc/showcase/*.png, *.gif (headless host, needs ffmpeg). Args: --only id,id --list"
                 :task (apply shell "clojure -M:showcase" *command-line-args*)}
  lesson:build  {:doc "Lesson bundle -> lesson.edn, lesson.json, notebook.clj, media, manifest.edn. Args: <lesson.edn> [out-dir, default dist/lessons/<id>]"
                 :task (apply shell "clojure -M -m desargues.lesson.export build" *command-line-args*)}
  lesson:verify {:doc "Rebuild a lesson bundle dir in a temp dir and compare sha256s with its manifest; exits 1 on a mismatch. Args: <dir>"
                 :task (apply shell "clojure -M -m desargues.lesson.export verify" *command-line-args*)}
  lesson:e2e    {:doc "Build a lesson, statically build its notebook (viewer bundle compiled by shadow-cljs, needs npm + network), then check it in headless Chromium (dev/e2e/lesson_render.mjs); exits 1 on a failed check. Screenshot: dist/lesson-e2e-<id>.png. Args: [lesson.edn, default lessons/area-under-curve.edn]"
                 :task (let [lesson (or (first *command-line-args*) "lessons/area-under-curve.edn")
                             id     (second (re-find (re-pattern ":lesson/id\\s+:([^\\s}]+)") (slurp lesson)))
                             dir    (str "dist/lessons/" id)
                             ;; outside the bundle dir: lesson:build prunes and
                             ;; lesson:verify flags files its manifest does not list
                             static (str "dist/lesson-e2e/" id)]
                         (shell "clojure -M -m desargues.lesson.export build" lesson)
                         (shell "clojure -M:notebooks:lesson-e2e -m desargues.lesson.static-build"
                                (str dir "/notebook.clj") static)
                         (when-not (fs/exists? "dev/e2e/node_modules/playwright-core")
                           (shell {:dir "dev/e2e"} "npm install --no-package-lock --no-audit --no-fund"))
                         (shell "node dev/e2e/lesson_render.mjs" lesson static))}
  serve         {:doc "Serve dist/site on http://localhost:8087"
                 :task (shell "python3 -m http.server 8087 --directory dist/site")}}}
