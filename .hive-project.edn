;; hive-mcp project configuration — desargues subrepo
;; Presentation/video layer for the economic-modeling workspace.
;; Emmy (symbolic) → LaTeX → Manim animations, with DevX hot-reload segments.

{:project-id "desargues"
 :description "Emmy→LaTeX→Manim mathematical-animation DSL — video/presentation layer"
 :type :library
 :parent-id "economic-modeling-refs"

 :watch-dirs ["src" "test"]
 :hot-reload true

 :tags ["clojure" "leiningen" "emmy" "manim" "animation" "video"
        "libpython-clj" "presentation"]

 ;; Role in the pipeline: renders the model output (T-accounts, balance-sheet
 ;; flows, money-multiplier expansion) into short videos & interactive scenes.
 :notes "Needs conda `manim` env; init via desargues.manim-quickstart/init!" 
 :carto {:source-roots ["dev" "src" "test"]}}
