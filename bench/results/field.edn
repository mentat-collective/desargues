 ;; alloc 7, kernel 7, download of 2073600 doubles 13, blit 3, rest launch/upload
 :gpu-breakdown-ms {:alloc 7.0 :invoke 6.9 :download 13.3 :blit 3.2}
 :agreement {:jvm-vs-raster "bit-identical" :jvm-vs-gpu "0 levels at 1080p ss1 (test bound: 1)"}}
