{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.3"}

  ;; symbolic math
  ;; fork release carrying upstream PRs #197-#200; back to upstream once merged
  io.github.mentat-collective/emmy {:git/url "https://github.com/BuddhiLW/emmy.git"
                                    :git/tag "v0.33.0-fork.1" :git/sha "1ed6094"}

  ;; python interop -> Manim CE (lives in the conda `manim` env, not on the JVM)
  clj-python/libpython-clj {:mvn/version "2.026"}

  ;; type safety — test.check (generators) + typed.clojure annotation runtime.
  ;; The checker (typed.clj.checker) is dev-only; it lives in :dev, not here.
  org.clojure/test.check {:mvn/version "1.1.1"}
  org.typedclojure/typed.clj.runtime {:mvn/version "1.3.0"}

  ;; disposition solver's logic tier (desargues.geometry.disposition) — small,
  ;; pure JVM, dev/build-time only: decks consume solved params as literals.
  org.clojure/core.logic {:mvn/version "1.1.1"}

  ;; config DI: hive-di defconfig (desargues.config). Dev overrides in local.deps.edn.
  io.github.hive-agi/hive-dsl {:git/tag "v0.5.1" :git/sha "335869e"}
  io.github.hive-agi/hive-di  {:git/tag "v0.3.1" :git/sha "ab63fd0"}
  org.clojure/core.async {:mvn/version "1.7.701"}
  org.clojure/data.json  {:mvn/version "2.5.1"}
  ;; value-object schemas (desargues.tracks.core)
  metosin/malli {:mvn/version "0.20.2"}}

 :aliases
 {;; desargues.core and the demos live in dev/, off the published :paths.
  :run  {:extra-paths ["dev"]
         :main-opts ["-m" "desargues.core"]}
  ;; `clojure -M:doctor` — is the JVM enough (yes, for the recording backend)
  ;; and is a Manim env reachable (conda prefix, manim import, latex, ffmpeg)?
  :doctor {:extra-deps {org.slf4j/slf4j-nop {:mvn/version "1.7.36"}}
           :main-opts ["-m" "desargues.doctor"]}
  ;; `clojure -M:bench:dynamics` — micro-benchmarks of the pure pipeline ->
  ;; bench/results/latest.edn + doc/bench/*.svg. Add --manim for render timings.
  :bench {:extra-paths ["bench" "site"]
          :extra-deps {org.slf4j/slf4j-nop {:mvn/version "1.7.36"}}
          :main-opts ["-m" "desargues.bench"]}
  ;; `bb site` — the landing page: a plato deck (site/) prerendered to dist/site.
  :site {:extra-paths ["site"]
         :extra-deps {io.github.BuddhiLW/plato {:git/sha "fabc9b6f18e24d0e91d0909d7e59e26724a46a38"}}
         :main-opts ["-m" "plato.cli"]}
  :dev  {:extra-paths ["dev"]
         :extra-deps {orchestra/orchestra {:mvn/version "2021.01.01-1"}
                      org.typedclojure/typed.clj.checker {:mvn/version "1.3.0"}
                      ;; hot-reload infrastructure (devx.watcher, devx.reload; dev/ only)
                      com.nextjournal/beholder {:mvn/version "1.0.2"}
                      io.github.tonsky/clj-reload {:mvn/version "0.7.1"}}}
  ;; `clojure -A:dev:studio` — the live player in a JavaFX window (studio/ holds
  ;; the JavaFX host adapter and demo constructs; the player core in src/ is
  ;; toolkit-free). Linux classifiers: tools.deps does not resolve OpenJFX's
  ;; per-platform Maven profiles.
  :studio {:extra-paths ["studio"]
           :extra-deps {org.openjfx/javafx-base$linux     {:mvn/version "25.0.4"}
                        org.openjfx/javafx-graphics$linux {:mvn/version "25.0.4"}
                        org.openjfx/javafx-controls$linux {:mvn/version "25.0.4"}
                        ;; :tex nodes paint through JLaTeXMath (plain-text fallback)
                        org.scilab.forge/jlatexmath {:mvn/version "1.0.7"}}
           :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  ;; `clojure -M:browser`: the stage in a browser: compiles the player .cljc
  ;; strata, desargues.objects and the Canvas2D host (browser/) with the plain
  ;; ClojureScript compiler into browser/public/js/main.js (no npm at build
  ;; time). `clojure -M:browser-record` re-records the demo scene graphs the
  ;; static page plays (browser/public/scenes/*.edn) on the JVM; viewing them
  ;; needs no JVM. `browser/check.sh` serves the page and asserts it paints.
  ;; studio/ is on the path for the shared object-demo registry
  ;; (desargues.studio.objects-demos, .cljc): the page plays the same demos.
  :browser {:extra-paths ["browser" "studio"]
            :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.134"}}
            :main-opts ["-m" "cljs.main" "-co" "browser/build.edn" "-c"]}
  ;; `clojure -M:browser-parity`: the same recorder compiled for Node, so
  ;; desargues.scene.parity-test can record every object demo on both hosts
  ;; and compare the EDN graphs.
  :browser-parity {:extra-paths ["browser" "studio"]
                   :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.134"}}
                   :main-opts ["-m" "cljs.main" "-co" "browser/parity.edn" "-c"]}
  :browser-record {:extra-paths ["browser" "studio"]
                   :extra-deps {org.slf4j/slf4j-nop {:mvn/version "1.7.36"}}
                   :main-opts ["-m" "desargues.browser.record"]}
  ;; `clojure -M:showcase` (or `bb showcase`): re-renders the README gallery,
  ;; doc/showcase/*.png and *.gif, through the headless PNG host. studio/ holds
  ;; the demo constructs (no JavaFX is loaded); JLaTeXMath typesets :tex.
  ;; Needs ffmpeg for the GIFs.
  :showcase {:extra-paths ["dev" "studio"]
             :extra-deps {org.scilab.forge/jlatexmath {:mvn/version "1.0.7"}
                          org.slf4j/slf4j-nop {:mvn/version "1.7.36"}}
             :main-opts ["-m" "desargues.showcase"]}
  ;; `clojure -M:test` runs every suite (cognitect test-runner; -n ns / -v var to
  ;; narrow). The Manim suites need the conda env; realize_test skips without it.
  :test {:extra-paths ["test" "dev" "bench" "site" "studio"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.hive-agi/hive-test {:git/tag "v0.4.11" :git/sha "4d20774cf592966c9ac54fa7fe7a1e2f7d6ae68d"}
                      com.nextjournal/beholder {:mvn/version "1.0.2"}
                      io.github.tonsky/clj-reload {:mvn/version "0.7.1"}}
         :jvm-opts ["-Dclojure.spec.check-asserts=true"]
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; Dynamics port -> raster (ODE engine) for desargues.infrastructure.raster-adapter.
  ;; Opt-in: raster pulls typed.clj.checker 1.4.0 + wasm. Its checker needs
  ;; typed.clj.runtime 1.4.0, which must OVERRIDE the top-level 1.3.0 pin here
  ;; (tools.deps keeps the top-level pin otherwise); the top-level pin stays at
  ;; 1.3.0 because the :dev typecheck gate runs checker 1.3.0.
  ;;   clojure -M:test:dynamics     # runs the raster conformance suite too
  ;; Chicory (pure-JVM wasm engine; the compiler turns wasm into JVM bytecode)
  ;; runs the trajectory modules raster emits: the :wasm backend.
  :dynamics {:extra-deps {io.github.replikativ/raster {:git/tag "v0.2.258" :git/sha "d0fb8f7"}
                          org.typedclojure/typed.clj.runtime {:mvn/version "1.4.0"}
                          com.dylibso.chicory/runtime {:mvn/version "1.5.1"}
                          com.dylibso.chicory/compiler {:mvn/version "1.5.1"}}
             :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                        "--add-modules=jdk.incubator.vector"]}
  :ansatz {:extra-paths ["ansatz"]
           :extra-deps {org.replikativ/ansatz {:mvn/version "0.2.115"}}
           :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :notebooks {:extra-paths ["notebooks" "studio"]
              :extra-deps {io.github.mentat-collective/emmy-viewers {:git/url "https://github.com/BuddhiLW/emmy-viewers.git" :git/tag "v0.4.0-fork.1" :git/sha "a19b1e3"}
                           org.mentat/clerk-utils {:mvn/version "0.6.0"}
                           org.scilab.forge/jlatexmath {:mvn/version "1.0.7"}
                           io.github.nextjournal/clerk {:git/sha "a67a5d1e25fc9601e9f8a6d8006aaf7eed1a7761"}
                           io.github.nextjournal/clerk.render {:git/url "https://github.com/nextjournal/clerk"
                                                               :git/sha "a67a5d1e25fc9601e9f8a6d8006aaf7eed1a7761"
                                                               :deps/root "render"}
                           org.babashka/sci {:git/url "https://github.com/babashka/sci"
                                             :git/sha "c556f4474303c61da72e7a07eef496dcbf66a56e"}}}}}
